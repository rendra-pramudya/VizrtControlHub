# Copy to .env and fill in. .env is git-ignored.
VIZ_HUB_PASSWORD=
# VIZ_HUB_USERNAME=

# Backend bind address. Default 127.0.0.1 (this PC only).
# Set to 0.0.0.0 only on a trusted network: the API has no authentication.
# HOST=127.0.0.1
# PORT=3000

# Extra browser origins allowed by CORS, comma-separated.
# CORS_ORIGINS=http://192.168.1.50:5173
